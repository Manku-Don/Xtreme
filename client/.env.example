# Copy this file to .env for local development:
#   cp .env.example .env
#
# VITE_API_BASE_URL — the base URL of the backend API (server/).
# Vite inlines this at BUILD time, not at runtime, so it must be set as a
# build-time environment variable on whatever platform builds the client
# (Vercel/Netlify project settings, your CI pipeline, etc). If you forget
# to set it there, the deployed site will silently try to call
# http://localhost:4000 and every API-backed feature (the contact form,
# WhatsApp opt-in, visit tracking, the /admin dashboard) will fail.
#
# Local development (server running on its default port):
VITE_API_BASE_URL=http://localhost:4000

# Production example — point this at wherever server/ is actually deployed:
# VITE_API_BASE_URL=https://api.xtremefitnessgym.in
