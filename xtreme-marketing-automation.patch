diff --git a/server/src/middleware/adminAuth.js b/server/src/middleware/adminAuth.js
new file mode 100644
index 0000000..d64a41e
--- /dev/null
+++ b/server/src/middleware/adminAuth.js
@@ -0,0 +1,20 @@
+// Very small gate for the admin/CRM endpoints: the gym owner's dashboard
+// sends the key back as `x-admin-key`. This is intentionally simple (no
+// user accounts, no sessions) since there's a single owner-operator — but
+// it does mean ADMIN_API_KEY in .env must be changed from the example
+// value before this ever goes on a public server.
+export function requireAdmin(req, res, next) {
+  const expected = process.env.ADMIN_API_KEY;
+  const provided = req.get("x-admin-key");
+
+  if (!expected || expected === "change-me-before-deploy") {
+    return res.status(503).json({
+      ok: false,
+      error: "Admin access isn't configured yet — set ADMIN_API_KEY in server/.env.",
+    });
+  }
+  if (provided !== expected) {
+    return res.status(401).json({ ok: false, error: "Invalid or missing admin key." });
+  }
+  next();
+}
diff --git a/server/src/middleware/visitor.js b/server/src/middleware/visitor.js
new file mode 100644
index 0000000..e44ec0d
--- /dev/null
+++ b/server/src/middleware/visitor.js
@@ -0,0 +1,25 @@
+import { randomUUID } from "node:crypto";
+
+const COOKIE_NAME = "xfg_vid";
+const ONE_YEAR_MS = 365 * 24 * 60 * 60 * 1000;
+
+// Assigns every browser a long-lived, anonymous visitor id (no personal data
+// in the cookie itself — just a random UUID). This is what lets us stitch
+// "viewed pricing 3 times over a week" into one story before we ever know
+// someone's name, and what a lead record gets linked back to once they do
+// hand over their phone number. Purely functional/analytics use, not
+// third-party ad tracking — worth saying so in a cookie-consent banner.
+export function visitorCookie(req, res, next) {
+  let vid = req.cookies?.[COOKIE_NAME];
+  if (!vid) {
+    vid = randomUUID();
+    res.cookie(COOKIE_NAME, vid, {
+      maxAge: ONE_YEAR_MS,
+      httpOnly: true,
+      sameSite: "lax",
+      secure: process.env.NODE_ENV === "production",
+    });
+  }
+  req.visitorId = vid;
+  next();
+}
