PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# --- Admin dashboard ---
# Sent as an `x-admin-key` header from client/src/pages/Admin.jsx.
# Change this to a real secret before deploying.
ADMIN_API_KEY=change-me-before-deploy

# --- Geo-proximity ("near you") feature ---
# Xtreme Fitness Gym, B-4 Pankha Rd, Dabri, New Delhi (from the Google listing).
GYM_LAT=28.6112664
GYM_LNG=77.0908111
# Visitors within this radius get the "you're nearby" on-site banner
# (precise, GPS-based — only checked when they click the button and grant
# browser location permission).
GEO_PROXIMITY_KM=5

# Coarse, IP-based service-area radius — runs passively on every visit (no
# permission prompt), used to tag visitors/leads as "local" for the admin
# dashboard's proximity sort and to decide who sees the homepage's "near you"
# section. Resolution is city/ISP-block level, so this is deliberately
# larger than GEO_PROXIMITY_KM above — it answers "are they even in the
# metro area?", not "are they 5km away".
SERVICE_AREA_RADIUS_KM=40

# --- WhatsApp Business Cloud API (Meta) ---
# Get these from developers.facebook.com -> your app -> WhatsApp -> API Setup.
# Leave blank to run in DRY-RUN mode: outbound messages are logged to
# server/data/db.json (whatsappLog) instead of actually being sent, so the
# whole automation pipeline (opt-in -> welcome -> drip) is fully testable
# before you have real Meta credentials.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Used by Meta to verify the webhook URL you register in the Meta dashboard.
# Make this any random string, then enter the SAME string in Meta's console.
WHATSAPP_VERIFY_TOKEN=change-me-before-deploy

# Approved WhatsApp message *template* names (templates are required for any
# business-initiated message sent outside the 24h customer-service window --
# see Meta's WhatsApp Business Platform docs). Create these in Meta Business
# Manager and get them approved before going live; names here must match
# exactly. Until they're approved, automation.js just logs a dry-run.
WHATSAPP_TEMPLATE_DAY1_REMINDER=xfg_demo_reminder
WHATSAPP_TEMPLATE_DAY3_INCENTIVE=xfg_demo_incentive
WHATSAPP_TEMPLATE_DAY7_WINBACK=xfg_winback_final

# --- Automation cadence (minutes) ---
# How often the drip-campaign queue is checked for due sends.
AUTOMATION_TICK_MINUTES=15
