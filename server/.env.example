# Copy this file to .env for local development:
#   cp .env.example .env
#
# None of these are required for the site to run locally — every one has a
# safe fallback (see comments) — but several MUST be set before this goes
# live for the site to work/be secure in production.

# --- Core server -------------------------------------------------------
PORT=4000
# The exact origin the client is served from — used for CORS. Must match
# your deployed frontend's URL in production (e.g. https://xtremefitnessgym.in).
CLIENT_ORIGIN=http://localhost:5173
# Set to "production" on your deploy platform — enables the secure/httpOnly
# visitor cookie flag (see middleware/visitor.js).
NODE_ENV=development

# --- Admin dashboard (REQUIRED before going live) -----------------------
# Without this set, /admin and GET /api/enquiry are locked out entirely
# (they fail closed, not open) — so the dashboard won't work until you set
# a real key here. Use a long random string, not a guessable word.
ADMIN_API_KEY=

# --- Gym location (used for proximity features) -------------------------
# Falls back to the real, hardcoded gym coordinates in constants.js if
# unset, so these are optional — only set them if the gym ever relocates.
GYM_LAT=28.6112664
GYM_LNG=77.0908111
# How close (km) counts as "near" for the precise GPS-based NearbyBanner
# check. Defaults to 5 if unset.
GEO_PROXIMITY_KM=5
# How wide (km) the coarse, passive IP-based "in service area" tag is.
# Defaults to 40 if unset.
SERVICE_AREA_RADIUS_KM=40

# --- WhatsApp Business Cloud API (Meta) ----------------------------------
# Leave all three blank to run the WhatsApp integration in dry-run/simulated
# mode (nothing real is sent, everything else still works for testing).
# Fill these in once you have an approved Meta WhatsApp Business app to send
# real messages:
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0
# Arbitrary string YOU choose and also enter in Meta's webhook setup page —
# used to verify inbound webhook calls are really from Meta.
WHATSAPP_VERIFY_TOKEN=

# --- Marketing automation -------------------------------------------------
# How often (minutes) the welcome/day-1/day-3/day-7 drip scheduler ticks.
# Defaults to 15 if unset.
AUTOMATION_TICK_MINUTES=15
